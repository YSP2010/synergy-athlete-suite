From e35e13c1b3bc2ee3a4a3db34a188c98e60f2215d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 20 Sep 2026 11:18:34 +0200
Subject: [PATCH 4/4] chore: add .env.example template

Documents the required Supabase and CRON_SECRET variables without real
values. The real .env should be untracked locally with
`git rm --cached .env` (it is already covered by .gitignore).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WwagmzvYAcqWRzAJyQX1hV
---
 .env.example | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)
 create mode 100644 .env.example

diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..6a8f144
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,17 @@
+# Supabase / Lovable Cloud – Zugangsdaten.
+# Diese Datei ist eine Vorlage OHNE echte Werte und darf eingecheckt werden.
+# Die echten Werte gehören in eine lokale .env (nicht committen!).
+#
+# Hinweis: PUBLISHABLE/ANON-Key und URL sind per VITE_-Prefix client-seitig
+# sichtbar (by design). Ein Service-Role-Key gehört NIEMALS in dieses Repo.
+
+SUPABASE_PROJECT_ID="your-supabase-project-id"
+SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
+SUPABASE_URL="https://your-project.supabase.co"
+
+VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
+VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
+VITE_SUPABASE_URL="https://your-project.supabase.co"
+
+# Nur serverseitig (Cron-Endpunkt /api/cron/reminders). NICHT mit VITE_ prefixen.
+CRON_SECRET="your-cron-secret"
